<Application x:Class="PortVisualizer.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:PortVisualizer.App.Services"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.Dark.xaml"/>
                <ResourceDictionary Source="Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="AccentBrush" Color="#00E5A0"/>
            <svc:BoolToVisibilityConverter x:Key="BoolVis"/>
            <svc:NullToVisibilityConverter x:Key="NullVis"/>
            <svc:HexToBrushConverter x:Key="HexBrush"/>
            <svc:StatusToBrushConverter x:Key="StatusBrush"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>

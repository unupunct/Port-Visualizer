<UserControl x:Class="PortVisualizer.App.Views.AlertsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,12">
            <CheckBox DockPanel.Dock="Right" Content="Show tray notifications" IsChecked="{Binding NotificationsEnabled}" VerticalAlignment="Bottom"/>
            <TextBlock Text="Alerts" Style="{StaticResource H1}"/>
            <TextBlock Text="Alerts follow rules you define. A match means &quot;you asked to be told&quot;, not &quot;this is malicious&quot;." Style="{StaticResource Muted}" Margin="16,0,0,0" VerticalAlignment="Bottom"/>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="16,14,16,6">
                    <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearAlertsCommand}" Margin="0" Padding="8,2"/>
                    <TextBlock Text="RECENT ALERTS" Style="{StaticResource H2}" Margin="0"/>
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="No alerts yet. Alerts appear when a connection event matches an enabled rule." Margin="16,6" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Alerts.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ListBox ItemsSource="{Binding Alerts}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="8,0,8,8">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="6,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Background="{Binding SeverityText, Converter={StaticResource StatusBrush}}" CornerRadius="2"/>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock FontSize="11"><Run Text="{Binding Time, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}"/><Run Text="   "/><Run Text="{Binding SeverityText, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="   "/><Run Text="{Binding Rule.Name, Mode=OneWay}" Foreground="{DynamicResource Accent2Brush}"/></TextBlock>
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding Event.Endpoints}" FontFamily="{StaticResource MonoFont}" FontSize="11" Style="{StaticResource Muted}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="RULES, WHITELISTS AND MONITORED PORTS" Style="{StaticResource H2}"/>
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="ADD A RULE" Style="{StaticResource H2}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding RuleTypes}" SelectedItem="{Binding NewType}" HorizontalAlignment="Stretch"/>
                            <TextBox Grid.Column="1" Text="{Binding NewName}" Tag="Rule name (optional)" ToolTip="Optional name" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="2" ItemsSource="{Binding Severities}" SelectedItem="{Binding NewSeverity}" Margin="0"/>
                        </Grid>
                        <TextBox Text="{Binding NewValue}" Tag="Value (IPs, ports, process names...)" Margin="0,8,0,0" Visibility="{Binding NeedsValue, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Text="{Binding Hint}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding Error, Converter={StaticResource NullVis}}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Add rule" Command="{Binding AddRuleCommand}" Style="{StaticResource PrimaryButton}"/>
                            <Button Content="Delete selected rule" Command="{Binding DeleteRuleCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <ListBox ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule, Mode=TwoWay}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,7">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="104"/></Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Top" Margin="2,2,0,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding TypeDisplay}" Style="{StaticResource Muted}" FontSize="11"/>
                                    <TextBlock Text="{Binding Value}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{DynamicResource Accent2Brush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <ComboBox Grid.Column="2" ItemsSource="{Binding DataContext.Severities, RelativeSource={RelativeSource AncestorType=ListBox}}" SelectedItem="{Binding Severity}" MinWidth="96" Margin="0" VerticalAlignment="Top"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

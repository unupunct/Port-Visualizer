<UserControl x:Class="PortVisualizer.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:PortVisualizer.App.Controls">
    <UserControl.Resources>
        <DataTemplate x:Key="BarTemplate">
            <Grid Margin="0,0,0,9">
                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontSize="12"/>
                <Border Grid.Column="1" Height="8" CornerRadius="4" Background="{DynamicResource BorderBrush}" VerticalAlignment="Center" Margin="6,0" ClipToBounds="True">
                    <Border Background="{Binding Color, Converter={StaticResource HexBrush}}" RenderTransformOrigin="0,0.5" HorizontalAlignment="Stretch">
                        <Border.RenderTransform><ScaleTransform ScaleX="{Binding Fraction, Mode=OneWay}"/></Border.RenderTransform>
                    </Border>
                </Border>
                <TextBlock Grid.Column="2" Text="{Binding Count}" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
            </Grid>
        </DataTemplate>
        <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="30"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,24">
            <DockPanel Margin="0,0,0,16">
                <TextBlock Text="Dashboard" Style="{StaticResource H1}"/>
                <TextBlock Text="Live data from the Windows connection tables. Nothing here is simulated." Style="{StaticResource Muted}" Margin="16,0,0,0" VerticalAlignment="Bottom"/>
            </DockPanel>

            <UniformGrid Columns="6" Margin="0,0,0,14">
                <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="TCP CONNECTIONS" Style="{StaticResource H2}" Margin="0" FontSize="10"/><TextBlock Text="{Binding TcpCount}" Style="{StaticResource StatValue}" Foreground="{DynamicResource Accent2Brush}"/></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="UDP ENDPOINTS" Style="{StaticResource H2}" Margin="0" FontSize="10"/><TextBlock Text="{Binding UdpCount}" Style="{StaticResource StatValue}" Foreground="#A855F7"/></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="LISTENING TCP PORTS" Style="{StaticResource H2}" Margin="0" FontSize="10"/><TextBlock Text="{Binding ListeningCount}" Style="{StaticResource StatValue}" Foreground="{DynamicResource AccentBrush}"/></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="UNIQUE REMOTE IPS" Style="{StaticResource H2}" Margin="0" FontSize="10"/><TextBlock Text="{Binding RemoteIpCount}" Style="{StaticResource StatValue}" Foreground="#3B82F6"/></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="NETWORK PROCESSES" Style="{StaticResource H2}" Margin="0" FontSize="10"/><TextBlock Text="{Binding ProcessCount}" Style="{StaticResource StatValue}"/></StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="NEW TODAY" Style="{StaticResource H2}" Margin="0" FontSize="10"/><TextBlock Text="{Binding NewToday}" Style="{StaticResource StatValue}" Foreground="#FACC15"/></StackPanel></Border>
            </UniformGrid>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="#00E5A0" VerticalAlignment="Center"/><TextBlock Text=" new   " Style="{StaticResource Muted}" FontSize="11"/>
                                    <Ellipse Width="8" Height="8" Fill="#FB923C" VerticalAlignment="Center"/><TextBlock Text=" closed" Style="{StaticResource Muted}" FontSize="11"/>
                                </StackPanel>
                                <TextBlock Text="CONNECTION ACTIVITY  (per polling cycle)" Style="{StaticResource H2}"/>
                            </DockPanel>
                            <ctl:ActivityChart Height="190" Samples="{Binding Activity}"/>
                        </StackPanel>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}">
                            <StackPanel><TextBlock Text="CURRENT DISTRIBUTION (BY STATE)" Style="{StaticResource H2}"/>
                                <ItemsControl ItemsSource="{Binding StateBars}" ItemTemplate="{StaticResource BarTemplate}"/></StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel><TextBlock Text="TCP VERSUS UDP" Style="{StaticResource H2}"/>
                                <ItemsControl ItemsSource="{Binding ProtocolBars}" ItemTemplate="{StaticResource BarTemplate}"/></StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="NETWORK STATUS" Style="{StaticResource H2}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="Monitoring" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding MonitoringStatus}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="1" Text="Last refresh" Style="{StaticResource Muted}" Margin="0,5,0,0"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LastRefresh}" Margin="0,5,0,0"/>
                                <TextBlock Grid.Row="2" Text="Errors" Style="{StaticResource Muted}" Margin="0,5,0,0"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Errors}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </Grid>
                            <TextBlock Text="ACTIVE INTERFACES" Style="{StaticResource H2}" Margin="0,14,0,6"/>
                            <ItemsControl ItemsSource="{Binding Interfaces}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Text="{Binding Addresses}" Style="{StaticResource Muted}" FontSize="11" FontFamily="{StaticResource MonoFont}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <DockPanel Height="262">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearFeedCommand}" Padding="8,2" Margin="0"/>
                                <CheckBox DockPanel.Dock="Right" Content="Pause" IsChecked="{Binding FeedPaused}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="LIVE ACTIVITY FEED" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ListBox ItemsSource="{Binding Feed}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Background="{Binding Accent, Converter={StaticResource HexBrush}}" CornerRadius="2"/>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock FontSize="11"><Run Text="{Binding Time, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}"/><Run Text="  "/><Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" Foreground="{Binding Accent, Converter={StaticResource HexBrush}}"/></TextBlock>
                                                <TextBlock Text="{Binding Process}" FontWeight="SemiBold" FontSize="12"/>
                                                <TextBlock Text="{Binding Endpoints}" FontFamily="{StaticResource MonoFont}" FontSize="11"/>
                                                <TextBlock Text="{Binding State}" Style="{StaticResource Muted}" FontSize="11"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="TOP PROCESSES" Style="{StaticResource H2}"/>
                        <StackPanel Height="290">
                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/><ColumnDefinition Width="46"/><ColumnDefinition Width="46"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="PROCESS" Foreground="{DynamicResource Accent2Brush}" FontSize="11" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="CONN." Foreground="{DynamicResource Accent2Brush}" FontSize="11" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="TCP" Foreground="{DynamicResource Accent2Brush}" FontSize="11" FontWeight="SemiBold"/><TextBlock Grid.Column="3" Text="UDP" Foreground="{DynamicResource Accent2Brush}" FontSize="11" FontWeight="SemiBold"/><TextBlock Grid.Column="4" Text="REMOTE IPS" Foreground="{DynamicResource Accent2Brush}" FontSize="11" FontWeight="SemiBold"/></Grid>
                            <ItemsControl ItemsSource="{Binding TopProcesses}"><ItemsControl.ItemTemplate><DataTemplate>
                                <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/><ColumnDefinition Width="46"/><ColumnDefinition Width="46"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12" Margin="0,0,6,0"/><TextBlock Grid.Column="1" Text="{Binding Connections}" FontSize="12" Margin="0,0,6,0"/><TextBlock Grid.Column="2" Text="{Binding Tcp}" FontSize="12" Margin="0,0,6,0"/><TextBlock Grid.Column="3" Text="{Binding Udp}" FontSize="12" Margin="0,0,6,0"/><TextBlock Grid.Column="4" Text="{Binding RemoteIps}" FontSize="12" Margin="0,0,6,0"/></Grid>
                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="TOP REMOTE ENDPOINTS" Style="{StaticResource H2}"/>
                        <StackPanel Height="290">
                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/><ColumnDefinition Width="56"/><ColumnDefinition Width="150"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="REMOTE IP" Foreground="{DynamicResource Accent2Brush}" FontSize="11" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="PORT" Foreground="{DynamicResource Accent2Brush}" FontSize="11" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="PROTO" Foreground="{DynamicResource Accent2Brush}" FontSize="11" FontWeight="SemiBold"/><TextBlock Grid.Column="3" Text="PROCESSES" Foreground="{DynamicResource Accent2Brush}" FontSize="11" FontWeight="SemiBold"/><TextBlock Grid.Column="4" Text="STATE" Foreground="{DynamicResource Accent2Brush}" FontSize="11" FontWeight="SemiBold"/></Grid>
                            <ItemsControl ItemsSource="{Binding TopRemotes}"><ItemsControl.ItemTemplate><DataTemplate>
                                <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/><ColumnDefinition Width="56"/><ColumnDefinition Width="150"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="{Binding Remote}" FontSize="12" Margin="0,0,6,0"/><TextBlock Grid.Column="1" Text="{Binding Port}" FontSize="12" Margin="0,0,6,0"/><TextBlock Grid.Column="2" Text="{Binding Protocol}" FontSize="12" Margin="0,0,6,0"/><TextBlock Grid.Column="3" Text="{Binding Processes}" FontSize="12" Margin="0,0,6,0"/><TextBlock Grid.Column="4" Text="{Binding State}" FontSize="12" Margin="0,0,6,0"/></Grid>
                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

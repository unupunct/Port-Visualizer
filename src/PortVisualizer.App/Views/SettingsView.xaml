<UserControl x:Class="PortVisualizer.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,24" MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource H1}" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding Message}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="{Binding Message, Converter={StaticResource NullVis}}"/>

            <Border Style="{StaticResource Card}" Margin="0,8,0,14">
                <StackPanel>
                    <TextBlock Text="MONITORING" Style="{StaticResource H2}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Refresh interval" Width="150" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding IntervalChoices}" DisplayMemberPath="Label" SelectedItem="{Binding RefreshChoice}" MinWidth="190"/>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsCustomInterval, Converter={StaticResource BoolVis}}">
                            <TextBox Text="{Binding CustomInterval}" Width="90" Margin="0,0,6,0"/>
                            <TextBlock Text="ms" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button Content="Apply" Command="{Binding ApplyCustomIntervalCommand}"/>
                        </StackPanel>
                    </StackPanel>
                    <WrapPanel>
                        <CheckBox Content="Monitor TCP" IsChecked="{Binding EnableTcp}" Width="190"/>
                        <CheckBox Content="Monitor UDP" IsChecked="{Binding EnableUdp}" Width="190"/>
                        <CheckBox Content="IPv4" IsChecked="{Binding EnableIPv4}" Width="190"/>
                        <CheckBox Content="IPv6" IsChecked="{Binding EnableIPv6}" Width="190"/>
                        <CheckBox Content="Monitor listening ports" IsChecked="{Binding MonitorListening}" Width="190"/>
                        <CheckBox Content="Record connection history" IsChecked="{Binding RecordHistory}" Width="220"/>
                    </WrapPanel>
                    <TextBlock Text="Monitoring only runs while Port Visualizer is open (window or system tray). It never starts with Windows on its own." Style="{StaticResource Muted}" FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="INTERFACE" Style="{StaticResource H2}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Theme" Width="150" VerticalAlignment="Center"/>
                        <ToggleButton Content="Dark" IsChecked="{Binding DarkTheme, Mode=TwoWay}"/>
                        <ToggleButton Content="Light" IsChecked="{Binding LightTheme, Mode=TwoWay}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Accent colour" Width="150" VerticalAlignment="Center"/>
                        <ItemsControl ItemsSource="{Binding Swatches}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.PickAccentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Hex}" ToolTip="{Binding Name}" Width="28" Height="28" Padding="0" Margin="0,0,8,0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button"><Ellipse Width="24" Height="24" Fill="{Binding Hex, Converter={StaticResource HexBrush}}" Stroke="{DynamicResource BorderBrush}" StrokeThickness="2"/></ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBox Text="{Binding CustomAccent}" Width="90" Tag="#RRGGBB" ToolTip="Custom colour, e.g. #00E5A0" Margin="10,0,6,0"/>
                        <Button Content="Set" Command="{Binding ApplyCustomAccentCommand}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Graph layout" Width="150" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding Layouts}" SelectedItem="{Binding GraphLayout}" MinWidth="190"/>
                    </StackPanel>
                    <CheckBox Content="Animate graph connection lines" IsChecked="{Binding GraphAnimation}"/>
                    <CheckBox Content="Minimise / close to the system tray (monitoring continues)" IsChecked="{Binding MinimizeToTray}"/>
                    <TextBlock Text="TABLE COLUMNS (Live Connections)" Style="{StaticResource H2}" Margin="0,12,0,6"/>
                    <ItemsControl ItemsSource="{Binding Columns}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Header}" IsChecked="{Binding IsVisible}" Width="170"/></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="ALERTS" Style="{StaticResource H2}"/>
                    <CheckBox Content="Enable tray notifications for alerts" IsChecked="{Binding NotificationsEnabled}"/>
                    <TextBlock Text="Which events raise alerts, custom IP/port/process rules and whitelists are managed on the Alerts page." Style="{StaticResource Muted}" FontSize="11.5" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="DATABASE" Style="{StaticResource H2}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Retention period" Width="150" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding RetentionChoices}" DisplayMemberPath="Label" SelectedItem="{Binding RetentionChoice}" MinWidth="190"/>
                    </StackPanel>
                    <TextBlock Text="Location" Style="{StaticResource Muted}" FontSize="11"/>
                    <TextBox Text="{Binding DatabasePath, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="0,2,0,10"/>
                    <WrapPanel>
                        <Button Content="Change location..." Command="{Binding ChangeDatabaseLocationCommand}"/>
                        <Button Content="Back up database..." Command="{Binding BackupDatabaseCommand}"/>
                        <Button Content="Export history..." Command="{Binding ExportHistoryCommand}"/>
                        <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}"/>
                        <Button Content="Clear history" Command="{Binding ClearHistoryCommand}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="PRIVACY AND PERMISSIONS" Style="{StaticResource H2}"/>
                    <CheckBox Content="Local-only mode (no network lookups of any kind)" IsChecked="{Binding LocalOnlyMode}"/>
                    <CheckBox Content="Disable reverse DNS" IsChecked="{Binding DisableReverseDns}"/>
                    <CheckBox Content="Do not record process executable paths in the database" IsChecked="{Binding DisablePathRecording}"/>
                    <TextBlock Text="{Binding ReverseDnsHint}" Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,10"/>
                    <WrapPanel>
                        <Button Content="Clear connection history" Command="{Binding ClearHistoryCommand}"/>
                        <Button Content="Open log folder" Command="{Binding OpenLogsCommand}"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding AdminText}" Margin="0,12,0,4"/>
                    <TextBlock Text="Basic monitoring never needs administrator rights. Elevation is optional and only helps Windows reveal the executable path of a few protected processes. Port Visualizer never kills processes, edits the firewall, captures packets or uploads data." Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap"/>
                    <Button Content="Restart as administrator..." Command="{Binding RestartAsAdminCommand}" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

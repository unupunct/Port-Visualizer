<UserControl x:Class="PortVisualizer.App.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <TextBlock Text="Processes" Style="{StaticResource H1}"/>
            <TextBlock Text="{Binding CountText}" Style="{StaticResource Muted}" Margin="16,0,0,0" VerticalAlignment="Bottom"/>
        </DockPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="320" Margin="0,0,10,0" Tag="Search executable name, path or PID..." ToolTip="Search"/>
            <Button Content="Open location" Command="{Binding OpenLocationCommand}"/>
            <Button Content="View properties" Command="{Binding ViewPropertiesCommand}"/>
            <Button Content="Copy info" Command="{Binding CopyInfoCommand}"/>
            <Button Content="Show connections" Command="{Binding ShowInLiveCommand}"/>
            <Button Content="Export summary" Command="{Binding ExportSummaryCommand}"/>
        </WrapPanel>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}" SelectionMode="Single" Margin="4">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="PROCESS" Binding="{Binding Name}" Width="170"/>
                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80"/>
                    <DataGridTextColumn Header="CONN." Binding="{Binding Total}" Width="76"/>
                    <DataGridTextColumn Header="TCP" Binding="{Binding Tcp}" Width="66"/>
                    <DataGridTextColumn Header="UDP" Binding="{Binding Udp}" Width="66"/>
                    <DataGridTextColumn Header="LISTEN" Binding="{Binding Listening}" Width="82"/>
                    <DataGridTextColumn Header="REMOTE IPS" Binding="{Binding RemoteIps}" Width="112"/>
                    <DataGridTextColumn Header="STARTED" Binding="{Binding Started}" Width="150"/>
                    <DataGridTextColumn Header="PUBLISHER" Binding="{Binding Publisher}" Width="150"/>
                    <DataGridTextColumn Header="SIGNATURE" Binding="{Binding Signature}" Width="180"/>
                    <DataGridTextColumn Header="EXECUTABLE PATH" Binding="{Binding Path}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="CONNECTIONS OF THE SELECTED PROCESS" Style="{StaticResource H2}" Margin="16,12,0,0"/>
                <DataGrid ItemsSource="{Binding SelectedConnections}" Margin="4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="90"/>
                        <DataGridTextColumn Header="PROTO" Binding="{Binding Protocol}" Width="64"/>
                        <DataGridTextColumn Header="LOCAL" Binding="{Binding LocalAddress}" Width="160"/>
                        <DataGridTextColumn Header="L.PORT" Binding="{Binding LocalPort}" Width="70"/>
                        <DataGridTextColumn Header="REMOTE" Binding="{Binding RemoteAddress}" Width="180"/>
                        <DataGridTextColumn Header="R.PORT" Binding="{Binding RemotePort}" Width="70"/>
                        <DataGridTextColumn Header="STATE" Binding="{Binding State}" Width="120"/>
                        <DataGridTextColumn Header="FIRST SEEN" Binding="{Binding FirstObserved}" Width="90"/>
                        <DataGridTextColumn Header="LAST SEEN" Binding="{Binding LastObserved}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="PortVisualizer.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:PortVisualizer.App.Controls"
             xmlns:vm="clr-namespace:PortVisualizer.App.ViewModels">
    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>

        <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,12">
            <TextBlock Text="Connection History" Style="{StaticResource H1}"/>
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="16,0,0,0" VerticalAlignment="Bottom"/>
        </DockPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,10">
            <WrapPanel>
                <ComboBox ItemsSource="{x:Static vm:HistoryViewModel.RangeChoices}" SelectedItem="{Binding RangeChoice}" MinWidth="140"/>
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsCustom, Converter={StaticResource BoolVis}}">
                    <TextBox Text="{Binding FromText}" Width="140" ToolTip="From (local time) yyyy-MM-dd HH:mm" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding ToText}" Width="140" ToolTip="To (local time) yyyy-MM-dd HH:mm" Margin="0,0,10,0"/>
                </StackPanel>
                <ComboBox ItemsSource="{x:Static vm:HistoryViewModel.TypeChoices}" SelectedItem="{Binding TypeChoice}" MinWidth="170"/>
                <TextBox Text="{Binding ProcessText}" Width="160" Margin="0,0,8,0" Tag="Process name" ToolTip="Process name contains..."/>
                <TextBox Text="{Binding IpText}" Width="160" Margin="0,0,8,0" Tag="IP address" ToolTip="IP address contains..."/>
                <TextBox Text="{Binding PortText}" Width="90" Margin="0,0,10,0" Tag="Port" ToolTip="Port (local or remote)"/>
                <Button Content="Search" Command="{Binding SearchCommand}" Style="{StaticResource PrimaryButton}"/>
                <Button Content="Reset" Command="{Binding ResetFiltersCommand}"/>
                <Button Content="Export..." Command="{Binding ExportCommand}"/>
            </WrapPanel>
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" Margin="0,6,0,0" Visibility="{Binding Error, Converter={StaticResource NullVis}}"/>
        </StackPanel>

        <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14,10">
            <StackPanel>
                <TextBlock Text="{Binding TimelineCaption}" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                <ctl:TimelineChart Buckets="{Binding Timeline}" Height="86"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Grid.ColumnSpan="3" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <Button DockPanel.Dock="Bottom" Content="Load more" Command="{Binding LoadMoreCommand}" HorizontalAlignment="Center" Margin="0,6,0,8" Visibility="{Binding CanLoadMore, Converter={StaticResource BoolVis}}"/>
                <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}" SelectionMode="Single" Margin="4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="TIME" Binding="{Binding Time}" Width="170"/>
                        <DataGridTextColumn Header="EVENT" Binding="{Binding Type}" Width="210"/>
                        <DataGridTextColumn Header="PROCESS" Binding="{Binding Process}" Width="170"/>
                        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80"/>
                        <DataGridTextColumn Header="PROTO" Binding="{Binding Protocol}" Width="80"/>
                        <DataGridTextColumn Header="LOCAL" Binding="{Binding Local}" Width="210"/>
                        <DataGridTextColumn Header="REMOTE" Binding="{Binding Remote}" Width="230"/>
                        <DataGridTextColumn Header="STATE" Binding="{Binding State}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Row="4" Grid.ColumnSpan="3" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Copy details" Command="{Binding CopyDetailsCommand}" Margin="12,0,0,0" VerticalAlignment="Top"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="110">
                    <TextBlock Text="{Binding DetailText}" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
